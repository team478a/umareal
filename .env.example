# Local-only password; generate a value and URL-encode it in DATABASE_URL.
LOCAL_DB_PASSWORD=
DATABASE_URL=
DIRECT_DATABASE_URL=
# One-time database access setup only. Never add these owner/runtime URLs to source control.
DATABASE_ADMIN_URL=
DATABASE_RUNTIME_URL=
# local is rejected when NODE_ENV=production. Supabase is the production candidate.
AUTH_PROVIDER=local
# CLOUD_STAGING is access-gated cloud testing; FREE_REGISTRATION and FULL require published legal documents in production.
LAUNCH_MODE=FULL
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://127.0.0.1:4000
# Managed hosting platforms provide PORT. API_PORT remains the local fallback.
PORT=
API_PORT=4000
# 32-byte base64 key for local MFA secrets.
ENCRYPTION_KEY=
# Required for Supabase Auth REST operations and JWT verification.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Not used by the application. Add a service-role key only when a reviewed server-only operation requires it.
SUPABASE_SERVICE_ROLE_KEY=
AUTH_JWT_SECRET=
# 管理画面未設定時だけ使用する互換用フォールバック。BILLING_TRANSPORTと本番安全スイッチは環境変数に残す。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
STRIPE_PRICE_FOUNDER=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_DAY_PASS=
# LINE credentials are entered by an AAL2 administrator and encrypted in system_settings.
ADMIN_BASE_URL=
JOB_SECRET=
# FREE_REGISTRATION disables LINE and billing; FULL uses test locally and live providers in production.
NOTIFICATION_TRANSPORT=test
LINE_OAUTH_TRANSPORT=test
BILLING_TRANSPORT=test
# Used by both API transaction mail and worker publication mail. Production requires resend.
MAIL_TRANSPORT=test
# Public email registration. Production startup requires turnstile; credentials are saved in the admin settings.
CAPTCHA_TRANSPORT=test
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM=
AUTH_RATE_LIMIT=600
LOCAL_RATE_LIMIT_MULTIPLIER=10
SENTRY_DSN=
