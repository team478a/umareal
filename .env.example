# Local-only password; generate a value and URL-encode it in DATABASE_URL.
LOCAL_DB_PASSWORD=
DATABASE_URL=
DIRECT_DATABASE_URL=
# One-time database access setup only. Never add these owner/runtime URLs to source control.
DATABASE_ADMIN_URL=
DATABASE_RUNTIME_URL=
# local is rejected when NODE_ENV=production. Supabase is the production candidate.
AUTH_PROVIDER=local
# CLOUD_STAGING is isolated cloud testing with noindex headers; FREE_REGISTRATION and FULL require published legal documents in production.
LAUNCH_MODE=FULL
APP_BASE_URL=http://localhost:3000
# 設定時は紹介URLをこのLPへ向ける。LP側でinviteを登録画面へ引き継ぐこと。
MARKETING_BASE_URL=
API_BASE_URL=http://127.0.0.1:4000
# Managed hosting platforms provide PORT. API_PORT remains the local fallback.
PORT=
API_PORT=4000
# 未設定時もMANUAL。MANUAL/CSV/JRA_VAN/OTHER_PROVIDERのいずれかを明示できる。
RACE_DATA_MODE=MANUAL
# 32-byte base64 key for local MFA secrets.
ENCRYPTION_KEY=
# 32バイト以上。Webが利用者IPを不可逆化し、非公開APIへ匿名キーだけを渡すためAPI/Webで同一値を設定。
RATE_LIMIT_PROXY_SECRET=
# Required for Supabase Auth REST operations and JWT verification.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Not used by the application. Add a service-role key only when a reviewed server-only operation requires it.
SUPABASE_SERVICE_ROLE_KEY=
AUTH_JWT_SECRET=
# 管理画面未設定時だけ使用する互換用フォールバック。BILLING_TRANSPORTと本番安全スイッチは環境変数に残す。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
STRIPE_PRICE_FOUNDER=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_DAY_PASS=
# LINE credentials are entered by an AAL2 administrator and encrypted in system_settings.
ADMIN_BASE_URL=
JOB_SECRET=
# CLOUD_STAGING uses the no-charge test transport. STRIPE_SANDBOX uses Stripe test keys and test webhooks. FREE_REGISTRATION disables billing; FULL uses live providers in production.
# Production FREE_REGISTRATION permits NOTIFICATION_TRANSPORT=disabled or line, independently of billing. Set API and worker together after queue review and a separate live-test approval.
NOTIFICATION_TRANSPORT=test
LINE_OAUTH_TRANSPORT=test
LINE_RICH_MENU_TRANSPORT=test
# test / stripe / bank_transfer / disabled。銀行振込は管理画面の口座設定も有効にする。
BILLING_TRANSPORT=test
# Used by both API transaction mail and worker publication mail. Production requires resend.
MAIL_TRANSPORT=test
# Public email registration. Production startup requires turnstile; credentials are saved in the admin settings.
CAPTCHA_TRANSPORT=test
# AIレースガイドは未設定時に全機能停止。Phase 1Aでは開発・CIでtestのみ使用する。
AI_RACE_GUIDE_ENABLED=false
AI_RACE_GUIDE_GENERATION_ENABLED=false
AI_RACE_GUIDE_PUBLICATION_ENABLED=false
# disabled | template（外部通信なしのBasic Guide）| test（非本番専用）
AI_RACE_GUIDE_TRANSPORT=disabled
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM=
AUTH_RATE_LIMIT=600
LOCAL_RATE_LIMIT_MULTIPLIER=10
SENTRY_DSN=
